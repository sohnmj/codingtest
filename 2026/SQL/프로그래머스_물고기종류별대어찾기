-- WHERE IN을 사용해서 더 간단하게 만들 수 있고 GROUP BY를 쓸때는 SELECT문에 관련이 안되는 칼럼을 넣지 않도록 주의하자
select INF.ID as ID, fni.FISH_NAME FISH_NAME, INF.LENGTH LENGTH
FROM
(SELECT MAX(LENGTH) LENGTH, FISH_TYPE
from FISH_INFO 
group by FISH_TYPE) F,FISH_INFO INF join FISH_NAME_INFO fni on INF.FISH_TYPE=fni.FISH_TYPE
WHERE F.LENGTH=INF.LENGTH AND F.FISH_TYPE=INF.FISH_TYPE
ORDER BY INF.ID