--단순하게 중복을 제거하기 위해 GROUP BY를 쓸 수 있다.                                                                  

SELECT CAR_ID, CASE 
WHEN 
CAR_ID IN (SELECT CAR_ID 
FROM CAR_RENTAL_COMPANY_RENTAL_HISTORY
WHERE START_DATE<='2022-10-16' AND END_DATE>='2022-10-16') THEN "대여중"
ELSE "대여 가능" 
END AS AVAILABILITY
FROM CAR_RENTAL_COMPANY_RENTAL_HISTORY
GROUP BY CAR_ID
ORDER BY CAR_ID DESC